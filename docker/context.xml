<!-- The contents of this file will be loaded for each web application -->
<Context>

    <!-- Default set of monitored resources. If one of these changes, the    -->
    <!-- web application will be reloaded.                                   -->
    <WatchedResource>WEB-INF/web.xml</WatchedResource>
    <WatchedResource>${catalina.base}/conf/web.xml</WatchedResource>

    <!--    <Manager className="com.amazonaws.services.dynamodb.sessionmanager.DynamoDBSessionManager"-->
    <!--             awsAccessKey="myAccessKey"-->
    <!--             awsSecretKey="mySecretKey"-->
    <!--             createIfNotExist="true" />-->

    <!-- The default value is 10240 kbytes, even when not added to context.xml.
    So increase it high enough, until the problem disappears, for example set it to
    a value 5 times as high: 51200. -->
    <Resources cacheMaxSize="51200"/>

    <!-- memcached-session-manager (msm) desactivado: el MEMCACHED_END_POINT apunta al
         Configuration Endpoint de Auto Discovery de ElastiCache, que msm/spymemcached
         no soportan de forma nativa (requeriria forkear msm para inyectar ClientMode.Dynamic
         del cliente de AWS). Con lockingMode="all" + sticky="true", el backup/lock contra ese
         endpoint fallaba de forma intermitente y corrompia el SecurityContext de la sesion en
         segundos (condicion de carrera visible en peticiones AJAX casi simultaneas a la carga
         del dashboard: la sesion aparecia como Anonymous durante una ventana de milisegundos).
         Volvemos al Manager por defecto de Tomcat (sesion en memoria local de cada tarea),
         apoyandonos en el sticky session del ALB (cf-templates/EC2-applicationloadbalancer_Internal.yaml)
         para la afinidad de sesion. Limitacion aceptada: si una tarea ECS se recicla, se pierden
         sus sesiones activas (no hay backup/failover). Revisar de nuevo si se decide migrar a
         Redis/Redisson-tomcat (mantenido activamente) o apuntar un nodo fijo de Memcache. -->

    <!-- Uncomment this to disable session persistence across Tomcat restarts -->
    <!--
    <Manager pathname="" />
    -->
</Context>
